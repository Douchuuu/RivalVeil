# ============================================
# RivalVeil .gitignore (Unity + Python Server)
# ============================================

# Секреты и окружение (КРИТИЧЕСКИ ВАЖНО)
.env
.env.local
.env.*.local

# Python / Server
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Виртуальные окружения Python
venv/
ENV/
env/
.venv/

# Базы данных
*.db
*.sqlite
*.sqlite3

# Серверные логи и тоннели
logs/
*.log
server_log.txt
cloudflared*

# ============================================
# Unity (Client)
# ============================================
/[L|l]ibrary/
/[T|t]emp/
/[O|o]bj/
/[B|b]uild/
/[B|b]uilds/
/[L|l]ogs/
/[U|u]ser[S|s]ettings/
/[M|m]emoryCaptures/
/[R|r]ecordings/
/[P|p]ackageCache/
.utmp/
Assets/_Recovery/

# ============================================
# IDE и файлы проектов (VS Code, Visual Studio, Rider)
# ============================================
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ============================================
# Файлы операционных систем
# ============================================
.DS_Store
Thumbs.db
desktop.ini